# Email recipient
SCREENER_EMAIL_TO=your.email@example.com

# SMTP settings. For Gmail, use an app password rather than your normal password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your.email@gmail.com
SMTP_USE_TLS=true
SMTP_USE_SSL=false
